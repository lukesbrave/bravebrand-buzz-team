{
  "id": "bravebrand.hire",
  "name": "BraveBrand Team",
  "apiVersion": 1,
  "description": "Recruit your AI team to build and grow a Digital Home you own.",
  "discovery": {
    "category": "agents",
    "tags": [
      "BraveBrand",
      "agents"
    ]
  },
  "host": {
    "networkOrigins": [
      "https://home.bravebrand.com"
    ],
    "commands": [
      {
        "id": "vps",
        "program": "ssh",
        "args": [
          "-T",
          "-o",
          "BatchMode=yes",
          "-o",
          "ConnectTimeout=3",
          "-o",
          "StrictHostKeyChecking=yes",
          "bravebrand-my-vps",
          "/opt/bravebrand/buzz-pilot/hires/bridge"
        ],
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    ]
  }
}
